{
  "id": "@artifactId@-@version@",
  "name": "CYCLOPS module",
  "provides": [
    {
      "id": "cyclops",
      "version": "1.0",
      "handlers": [
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/version",
          "permissionsRequired": []
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/tags",
          "permissionsRequired": [
            "cyclops.tags.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/tags",
          "permissionsRequired": [
            "cyclops.tags.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/filters",
          "permissionsRequired": [
            "cyclops.filters.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/filters",
          "permissionsRequired": [
            "cyclops.filters.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/sets",
          "permissionsRequired": [
            "cyclops.sets.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets",
          "permissionsRequired": [
            "cyclops.sets.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/sets/{setName}",
          "permissionsRequired": [
            "cyclops.sets.item.get"
          ]
        },
        {
          "methods": [
            "DELETE"
          ],
          "pathPattern": "/cyclops/sets/{setName}",
          "permissionsRequired": [
            "cyclops.sets.item.delete"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets/{setName}/add",
          "permissionsRequired": [
            "cyclops.sets.item.add-objects.post"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets/{setName}/remove",
          "permissionsRequired": [
            "cyclops.sets.item.remove-objects.post"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets/{setName}/tags/{tagName}",
          "permissionsRequired": [
            "cyclops.sets.item.modify-tags.post"
          ],
          "permissionsDesired": [
            "cyclops.sets.item.add-tags.post",
            "cyclops.sets.item.remove-tags.post"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets/{setName}/batch",
          "permissionsRequired": [
            "cyclops.sets.item.spectres.collection.post"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/sets/{setName}/{recordId}",
          "permissionsRequired": [
            "cyclops.sets.item.spectres.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/projects",
          "permissionsRequired": [
            "cyclops.projects.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/projects",
          "permissionsRequired": [
            "cyclops.projects.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/projects/{id}",
          "permissionsRequired": [
            "cyclops.projects.item.get"
          ]
        },
        {
          "methods": [
            "DELETE"
          ],
          "pathPattern": "/cyclops/projects/{id}",
          "permissionsRequired": [
            "cyclops.projects.item.delete"
          ]
        },
        {
          "methods": [
            "PUT"
          ],
          "pathPattern": "/cyclops/projects/{id}",
          "permissionsRequired": [
            "cyclops.projects.item.put"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/projects/{id}/sets",
          "permissionsRequired": [
            "cyclops.projects.item.sets.collection.get"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/funds",
          "permissionsRequired": [
            "cyclops.funds.collection.get"
          ]
        },
        {
          "methods": [
            "POST"
          ],
          "pathPattern": "/cyclops/funds",
          "permissionsRequired": [
            "cyclops.funds.item.post"
          ]
        },
        {
          "methods": [
            "GET"
          ],
          "pathPattern": "/cyclops/funds/{id}",
          "permissionsRequired": [
            "cyclops.funds.item.get"
          ]
        },
        {
          "methods": [
            "PUT"
          ],
          "pathPattern": "/cyclops/funds/{id}",
          "permissionsRequired": [
            "cyclops.funds.item.put"
          ]
        },
        {
          "methods": [
            "DELETE"
          ],
          "pathPattern": "/cyclops/funds/{id}",
          "permissionsRequired": [
            "cyclops.funds.item.delete"
          ]
        }
      ]
    }
  ],
  "requires": [],
  "permissionSets": [
    {
      "permissionName": "cyclops.tags.collection.get",
      "displayName": "CYCLOPS: Read list of tags"
    },
    {
      "permissionName": "cyclops.tags.item.post",
      "displayName": "CYCLOPS: Create tag"
    },
    {
      "permissionName": "cyclops.filters.collection.get",
      "displayName": "CYCLOPS: Read list of filters"
    },
    {
      "permissionName": "cyclops.filters.item.post",
      "displayName": "CYCLOPS: Create filter"
    },
    {
      "permissionName": "cyclops.sets.collection.get",
      "displayName": "CYCLOPS: Read list of sets"
    },
    {
      "permissionName": "cyclops.sets.item.post",
      "displayName": "CYCLOPS: Create set"
    },
    {
      "permissionName": "cyclops.sets.item.get",
      "displayName": "CYCLOPS: Retrieve objects from set"
    },
    {
      "permissionName": "cyclops.sets.item.delete",
      "displayName": "CYCLOPS: Delete set"
    },
    {
      "permissionName": "cyclops.sets.item.add-objects.post",
      "displayName": "CYCLOPS: Add objects to set (UNIMPLEMENTED)"
    },
    {
      "permissionName": "cyclops.sets.item.remove-objects.post",
      "displayName": "CYCLOPS: Remove objects from set (UNIMPLEMENTED)"
    },
    {
      "permissionName": "cyclops.sets.item.modify-tags.post",
      "displayName": "CYCLOPS: Add/remove tags from objects in a set"
    },
    {
      "permissionName": "cyclops.sets.item.add-tags.post",
      "displayName": "CYCLOPS: Add tags to objects in a set (UNIMPLEMENTED)",
      "subPermissions": ["cyclops.sets.item.modify-tags.post"]
    },
    {
      "permissionName": "cyclops.sets.item.remove-tags.post",
      "displayName": "CYCLOPS: Remove tags from objects in a set (UNIMPLEMENTED)",
      "subPermissions": ["cyclops.sets.item.modify-tags.post"]
    },
    {
      "permissionName": "cyclops.sets.item.spectres.item.post",
      "displayName": "CYCLOPS: Update a record (spectre) within a set"
    },
    {
      "permissionName": "cyclops.sets.item.spectres.collection.post",
      "displayName": "CYCLOPS: Batch-update multiple records (spectres) within a set"
    },
    {
      "permissionName": "cyclops.projects.collection.get",
      "displayName": "CYCLOPS: Read list of projects"
    },
    {
      "permissionName": "cyclops.projects.item.sets.collection.get",
      "displayName": "CYCLOPS: Read list of sets in a project"
    },
    {
      "permissionName": "cyclops.projects.item.post",
      "displayName": "CYCLOPS: Create projects"
    },
    {
      "permissionName": "cyclops.projects.item.get",
      "displayName": "CYCLOPS: Read full projects"
    },
    {
      "permissionName": "cyclops.projects.item.delete",
      "displayName": "CYCLOPS: Delete projects"
    },
    {
      "permissionName": "cyclops.projects.item.put",
      "displayName": "CYCLOPS: Modify projects"
    },
    {
      "permissionName": "cyclops.funds.collection.get",
      "displayName": "CYCLOPS: Read list of funds"
    },
    {
      "permissionName": "cyclops.funds.item.post",
      "displayName": "CYCLOPS: Create fund"
    },
    {
      "permissionName": "cyclops.funds.item.get",
      "displayName": "CYCLOPS: Read full fund"
    },
    {
      "permissionName": "cyclops.funds.item.put",
      "displayName": "CYCLOPS: Modify fund"
    },
    {
      "permissionName": "cyclops.funds.item.delete",
      "displayName": "CYCLOPS: Delete fund"
    }
  ],
  "launchDescriptor": {
    "dockerImage": "@artifactId@:@version@",
    "dockerPull": false,
    "dockerArgs": {
      "HostConfig": {
        "Memory": 100000000,
        "PortBindings": {
          "12370/tcp": [
            {
              "HostPort": "%p"
            }
          ]
        }
      }
    },
    "env": [
      {
        "name": "LOGCAT",
        "value": "listen,path,op,status,db,error"
      },
      {
        "name": "MOD_CYCLOPS_QUERY_TIMEOUT",
        "value": "300"
      }
    ]
  }
}
