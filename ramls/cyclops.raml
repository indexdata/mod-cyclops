#%RAML 1.0
title: CYCLOPS (CCLP) API
version: v1
protocols: [ HTTP, HTTPS ]
baseUri: https://github.com/indexdata/mod-cyclops/

documentation:
  - title: CYCLOPS (CCLP) API
    content: API calls to interact with the various CCMS commands
  - title: Overview
    content: !include overview.md

/cyclops:
  /version:
    description: "The version of the running server"
    get:
      description: "Return the VCS revision that the running server was built from"
      responses:
        200:
          body:
            text/plain:
              type: string
              example: 7b3d6be1f0c4a29d5e8b3a71c6f4d2e9b8a05c31
  /tags:
    description: "Tags that can be applied to records in a set"
    get:
      description: "Return a list of all known tags"
      responses:
        200:
          body:
            application/json:
              type: !include tags-schema.json
              example: !include examples/show-tags-example.json
    post:
      description: "Create a new tag"
      body:
        application/json:
          type: !include tag-schema.json
          example: !include examples/tag-example.json
      responses:
        204:
          description: No content is returned.
  /filters:
    description: "Filters that can narrow down records within a set"
    get:
      description: "Return a list of all known filters, with their projects and definitions; or, if a project is specified, only the filters in that project"
      queryParameters:
        project:
          type: string
          required: false
          description: The machine-readable identifier of a project, to restrict the listed filters to those in that project
          example: korea_lit
      responses:
        200:
          body:
            application/json:
              type: !include filters-schema.json
              example: !include examples/show-filters-example.json
    post:
      description: "Create a new filter"
      body:
        application/json:
          type: !include filter-schema.json
          example: !include examples/filter-example.json
      responses:
        204:
          description: No content is returned.
    /{filterId}:
      uriParameters:
        filterId:
          description: The machine-readable identifier of the filter, qualified by its project as "project.filter"
          type: string
          required: true
          example: korea_lit.jurassic
      delete:
        description: "Drop an existing filter"
        responses:
          204:
            description: No content is returned.
  /sets:
    description: "Sets of objects (books, films, etc.)"
    get:
      description: "Return a list of all known sets, with their projects and titles"
      responses:
        200:
          body:
            application/json:
              type: !include sets-schema.json
              example: !include examples/show-sets-example.json
    post:
      description: "Create a new set, with an optional title"
      body:
        application/json:
          type: !include set-schema.json
          example: !include examples/set-example.json
      responses:
        204:
          description: No content is returned.

    /{setName}:
      uriParameters:
        setName:
          description: The name of the set to retrieve from, modify, delete or tag
          type: string
          required: true
      get:
        description: "Retrieve elements of a set"
        queryParameters:
          fields:
            type: string
            required: true
            description: Either * (for all fields) or a comma-separated list
          cond:
            type: string
            required: false
            description: An SQL-like WHERE condition
          filter:
            type: string
            required: false
            description: The name of a filter to apply to the set
          tag:
            type: string
            required: false
            description: The name of a tag to which to restrict the retrieved objects
          omitTag:
            type: string
            required: false
            description: The name of a tag by which to exclude objects from the retrieved
          sort:
            type: string
            required: false
            description: a comma-separated list of fields to sort the objects on. The default order is undefined if this is not specified
          offset:
            type: number
            required: false
            description: number of objects that will be skipped and not returned as part of the result. This can be useful for retrieving objects one page of data a time. Note that 'sort' is required whenever this is used
          limit:
            type: string
            required: false
            description: a maximum number of objects that will be returned
          countOnly:
            type: boolean
            required: false
            description: If present and true, then no records are returned but an estimated count of how many records match the specified criteria. Perhaps surprisingly, this can take longer than actually retrieving some slice of the records.
        responses:
          200:
            body:
              application/json:
                type: !include retrieve-schema.json
                example: !include examples/retrieve-example.json
      put:
        description: "Alter an existing set, changing its title"
        body:
          application/json:
            type: !include set-schema.json
            example: !include examples/set-example.json
        responses:
          204:
            description: No content is returned.
      delete:
        description: "Delete a set"
        responses:
          204:
            description: No content is returned.
      /add:
        post:
          description: "add objects to a set"
          body:
            application/json:
              type: !include addobjects-schema.json
              example: !include examples/addobject-example.json
          responses:
            204:
              description: No content is returned.
      /remove:
        post:
          description: "remove objects from a set"
          body:
            application/json:
              type: !include removeobjects-schema.json
              example: !include examples/removeobject-example.json
          responses:
            204:
              description: No content is returned.
      /tags:
        /{tagName}:
          uriParameters:
            tagName:
              description: The name of the tag to add or remove to object within the set. The path `/cyclops/sets/mike/tags/dino` represents the resource "the set of records that are tagged with `dino` in the set `mike`.
              type: string
              required: true
          post:
            description: "add tag to, or remove tag from, objects within in a set"
            body:
              application/json:
                type: !include addremovetag-schema.json
                examples:
                  add:
                    value: !include examples/addtag-example.json
                  remove:
                    value: !include examples/removetag-example.json
            responses:
              204:
                description: No content is returned.
      /batch:
        post:
          description: "Apply the same field-changes to multiple records within a set at once"
          body:
            application/json:
              type: !include batch-schema.json
              example: !include examples/batch-example.json
          responses:
            204:
              description: No content is returned.
      /{recordId}:
        uriParameters:
          recordId:
            description: The identifier of the record within the set to update
            type: string
            required: true
        post:
          description: "Update the fields of a single record within a set"
          body:
            application/json:
              type: !include spectre-schema.json
              example: !include examples/spectre-example.json
          responses:
            204:
              description: No content is returned.
  /projects:
    description: "The projects in the system, in which collaborative collection management takes place"
    get:
      description: "Return a brief list of all known projects"
      responses:
        200:
          body:
            application/json:
              type: !include projects-schema.json
              example: !include examples/show-projects-example.json
    post:
      description: "Create a new project"
      body:
        application/json:
          type: !include project-schema.json
          example: !include examples/project-example.json
      responses:
        204:
          description: No content is returned.
    /{projectId}:
      uriParameters:
        projectId:
          description: The machine-readable identifier of the project
          type: string
          required: true
      get:
        description: "Fetch a full project"
        responses:
          200:
            body:
              application/json:
                type: !include project-schema.json
                example: !include examples/project-example.json
      delete:
        description: "Delete a project"
        responses:
          204:
            description: No content is returned.
      put:
        description: "Modify a project"
        body:
          application/json:
            type: !include project-schema.json
            example: !include examples/project-example.json
        responses:
          204:
            description: No content is returned.
      /sets:
        description: "Sets of objects (books, films, etc.) in this project"
        get:
          description: "Return a list of all known sets in this project, with their titles"
          responses:
            200:
              body:
                application/json:
                  type: !include sets-schema.json
                  example: !include examples/show-sets-example.json
  /funds:
    description: "Funds that can be associated with a project or assigned to a spectre"
    get:
      description: "Return a list of all known funds"
      responses:
        200:
          body:
            application/json:
              type: !include funds-schema.json
              example: !include examples/show-funds-example.json
    post:
      description: "Create a new fund"
      body:
        application/json:
          type: !include fund-schema.json
          example: !include examples/fund-example.json
      responses:
        204:
          description: No content is returned.
    /{fundId}:
      uriParameters:
        fundId:
          description: The machine-readable identifier of the fund
          type: string
          required: true
      get:
        description: "Show a single fund in full"
        responses:
          200:
            body:
              application/json:
                type: !include fund-schema.json
                example: !include examples/fund-example.json
      put:
        description: "Alter an existing fund"
        body:
          application/json:
            type: !include fund-schema.json
            example: !include examples/fund-example.json
        responses:
          204:
            description: No content is returned.
      delete:
        description: "Drop an existing fund"
        responses:
          204:
            description: No content is returned.
