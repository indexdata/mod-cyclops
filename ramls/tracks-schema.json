{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "A list of zero or more tracks",
  "type": "object",
  "properties": {
    "tracks": {
      "description": "The known tracks",
      "type": "array",
      "items": {
        "type": "object",
        "description": "A track",
        "properties": {
          "id": {
            "type": "string",
            "description": "The short machine-readable identifier of the track"
          },
          "name": {
            "type": "string",
            "description": "The human-readable name of the track"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tracks"
  ]
}
